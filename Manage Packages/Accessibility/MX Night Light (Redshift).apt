#!/bin/bash
jsf_no_pause="1"

app_name="JS-Forge"
runtime_core_path="${JSF_RUNTIME_CORE_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/$app_name/runtime-core.lib}"

source "$runtime_core_path" || {
    echo "Fatal: failed to source JS-Forge runtime: $runtime_core_path" >&2
    exit 1
}

jsf_init_runtime_core


mx_night_light_url="https://github.com/DevuboxLinux/mx-night-light/releases/download/0.5.1/mx-night-light_0.5.0+mx25_all.deb"
mx_night_light_deb="$(mktemp --suffix=.deb)"

trap 'rm -f "$mx_night_light_deb"' EXIT

echo "Downloading MX Night Light..."

curl -fL --retry 3 \
    --output "$mx_night_light_deb" \
    "$mx_night_light_url" || {
        echo "Failed to download MX Night Light." >&2
        exit 1
    }

echo "Installing MX Night Light..."
printf " 🔐 "

sudo apt install -y "$mx_night_light_deb"