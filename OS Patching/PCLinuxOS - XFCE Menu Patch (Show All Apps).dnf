#!/bin/bash
#jsf_no_pause="1"

app_name="JS-Forge"
runtime_core_path="${JSF_RUNTIME_CORE_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/$app_name/runtime-core.lib}"

source "$runtime_core_path" || {
	echo "Fatal: failed to source JS-Forge runtime: $runtime_core_path" >&2
	exit 1
}

jsf_init_runtime_core

jsf_require_all \
	--flatpak it.mijorus.gearlever

jsf_detect_desktop_environment() {
	local de="${XDG_CURRENT_DESKTOP:-}"

	if [ -z "$de" ]; then
		de="$(echo "$XDG_DATA_DIRS" | sed 's/.*\(xfce\|kde\|gnome\).*/\1/' 2>/dev/null)"
	fi

	de="$(printf '%s' "$de" | tr '[:upper:]' '[:lower:]')"
	printf '%s\n' "$de"
}

jsf_patch_gearlever_desktop_categories() {
	run_only_if_patching="0"
	local desktop="$HOME/.local/share/applications/it.mijorus.gearlever.desktop"
	local mandriva_cat="X-MandrivaLinux-System-Configuration-Packaging"

	if [ ! -f "$desktop" ]; then
		echo "Gear Lever desktop file not found at $desktop"
		return 0
	fi

	if grep -q "$mandriva_cat" "$desktop"; then
		echo "Mandriva category already present in Gear Lever desktop file"
	else
		echo "Patching Gear Lever desktop file"
		run_only_if_patching="1"

		if grep -q '^Categories=' "$desktop"; then
			sed -i.bak \
				-e "/^Categories=/{
                    s/;[[:space:]]*$//;
                    s/$/;${mandriva_cat};/
                }" \
				"$desktop"
		else
			sed -i.bak \
				-e "/^\[Desktop Entry\]/a Categories=${mandriva_cat};" \
				"$desktop"
		fi
	fi
}

jsf_patch_xfce_menu_show_all_other() {
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    local menu_dir="${config_home}/menus"
    local user_menu="${menu_dir}/xfce-applications.menu"
    local system_menu="/etc/xdg/menus/xfce-applications.menu"
	run_only_if_patching="0"

    mkdir -p "$menu_dir"

    if [ ! -f "$user_menu" ]; then
        cp "$system_menu" "$user_menu" || return 1
    fi

    if grep -q '<Name>Other</Name>' "$user_menu"; then
        echo "Other menu already defined in $user_menu"
    else
		run_only_if_patching="1"
		echo "Applying override in $user_menu"
        awk '
            /<MergeFile>applications-kmenuedit.menu<\/MergeFile>/ && !done {
                print "  <Menu>"
                print "    <Name>Other</Name>"
                print "    <Directory>xfce-other.directory</Directory>"
                print "    <OnlyUnallocated/>"
                print "    <Include>"
                print "      <All/>"
                print "    </Include>"
                print "  </Menu>"
                done=1
            }
            { print }
        ' "$user_menu" > "${user_menu}.tmp" && mv "${user_menu}.tmp" "$user_menu"
		echo "Operation complete"
    fi
}

jsf_refresh_xfce_menu_cache() {
    pkill xfce4-appfinder 2>/dev/null || true
    rm -rf "$HOME/.cache/xfce4/appfinder"
    rm -rf "$HOME/.cache/menu-cache"
    update-desktop-database "$HOME/.local/share/applications/" 2>/dev/null || true
    xfce4-panel -r 2>/dev/null || true
}

if [ "$(jsf_detect_distro_family)" = "mandriva" ]; then
	case "$(jsf_detect_desktop_environment)" in
	xfce)
		jsf_patch_gearlever_desktop_categories
		if [ "$run_only_if_patching" == "1" ]; then
			jsf_refresh_xfce_menu_cache
		fi

		jsf_patch_xfce_menu_show_all_other
			if [ "$run_only_if_patching" == "1" ]; then
            jsf_refresh_xfce_menu_cache
			fi
		;;
	kde)
		# add KDE-specific refresh logic later if needed
		;;
	esac
fi