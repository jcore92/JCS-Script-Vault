#!/bin/bash
#jsf_no_pause="1"

app_name="JS-Forge"
runtime_core_path="${JSF_RUNTIME_CORE_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/$app_name/runtime-core.lib}"

source "$runtime_core_path" || {
    echo "Fatal: failed to source JS-Forge runtime: $runtime_core_path" >&2
    exit 1
}

jsf_init_runtime_core

script_title="GeekosDAW Repository"
geekos_repo_alias="jsf-geekosdaw-proaudio"
geekos_repo_url=""
geekos_release_label=""

pause_screen() {
    echo ""
    entertocontinue
}

run_as_root() {
    if [ "$EUID" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

choose() {
    local prompt="$1" result_var="$2"
    shift 2
    cursor_menu "$prompt" "$result_var" "$@"
}

require_opensuse() {
    command -v zypper >/dev/null 2>&1 || {
        echo "zypper was not found. This installer is for openSUSE systems."
        return 1
    }

    [ -r /etc/os-release ] || {
        echo "Could not identify the installed openSUSE release."
        return 1
    }
}

detect_geekos_repo() {
    local distro_id version_id

    require_opensuse || return 1
    distro_id="$(. /etc/os-release; printf '%s' "${ID,,}")"
    version_id="$(. /etc/os-release; printf '%s' "$VERSION_ID")"

    case "$distro_id" in
        opensuse-tumbleweed)
            geekos_release_label="openSUSE Tumbleweed"
            geekos_repo_url="https://download.opensuse.org/repositories/multimedia:/proaudio/openSUSE_Tumbleweed/"
            ;;
        opensuse-slowroll)
            geekos_release_label="openSUSE Slowroll"
            geekos_repo_url="https://download.opensuse.org/repositories/multimedia:/proaudio/openSUSE_Slowroll/"
            ;;
        opensuse-leap)
            [ -n "$version_id" ] || {
                echo "Could not determine the installed openSUSE Leap version."
                return 1
            }
            geekos_release_label="openSUSE Leap $version_id"
            geekos_repo_url="https://download.opensuse.org/repositories/multimedia:/proaudio/openSUSE_Leap_${version_id}/"
            ;;
        *)
            echo "This script supports openSUSE Tumbleweed, Slowroll, and Leap."
            echo "Detected system ID: $distro_id"
            return 1
            ;;
    esac
}

install_or_update_repo() {
    local selection
    local options=("Install or update repository" "Cancel")

    detect_geekos_repo || return 1

    clear
    echo "$script_title"
    divider
    echo "Detected release: $geekos_release_label"
    echo "Repository URL:"
    echo "$geekos_repo_url"
    echo ""
    echo "This will replace only the existing JS-Forge GeekosDAW repository entry, if present."
    echo "It does not install or update any audio packages by itself."
    echo ""

    choose "Continue?" selection "${options[@]}"
    [ "$selection" = "Install or update repository" ] || return 0

    run_as_root zypper --non-interactive removerepo "$geekos_repo_alias" >/dev/null 2>&1 || true

    run_as_root zypper --non-interactive addrepo --refresh \
        "$geekos_repo_url" "$geekos_repo_alias" || {
        echo "Could not add the GeekosDAW repository."
        return 1
    }

    run_as_root zypper --non-interactive --gpg-auto-import-keys refresh "$geekos_repo_alias" || {
        echo "The repository was added, but metadata refresh failed."
        return 1
    }

    echo "GeekosDAW repository is ready for $geekos_release_label."
}

show_status() {
    clear
    echo "$script_title"
    divider

    if detect_geekos_repo; then
        echo "Detected release: $geekos_release_label"
        echo "Expected repository URL:"
        echo "$geekos_repo_url"
    fi

    echo ""
    echo "Current JS-Forge GeekosDAW repository entry:"
    zypper lr -u 2>/dev/null | grep -F "$geekos_repo_alias" || echo "Not installed."
}

remove_repo() {
    local selection
    local options=("Remove GeekosDAW repository" "Cancel")

    require_opensuse || return 1
    choose "Remove only the JS-Forge GeekosDAW repository entry?" selection "${options[@]}"
    [ "$selection" = "Remove GeekosDAW repository" ] || return 0

    if run_as_root zypper --non-interactive removerepo "$geekos_repo_alias"; then
        echo "GeekosDAW repository removed. Installed packages were not changed."
    else
        echo "No JS-Forge GeekosDAW repository entry was found."
    fi
}

menu() {
    local selection
    local options=(
        "Install or update GeekosDAW repository"
        "Check GeekosDAW repository status"
        "Remove GeekosDAW repository"
        "Exit"
    )

    while true; do
        clear
        echo "$script_title"
        divider
        choose "Select an option:" selection "${options[@]}"

        case "$selection" in
            "Install or update GeekosDAW repository") install_or_update_repo ;;
            "Check GeekosDAW repository status") show_status ;;
            "Remove GeekosDAW repository") remove_repo ;;
            "Exit") return 0 ;;
        esac

        [ "$selection" = "Exit" ] || pause_screen
    done
}

menu
